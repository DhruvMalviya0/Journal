{
  "name": "automated-coursework-journal",
  "version": "1.0.0",
  "description": "Automated daily coursework journal submitter for Google Forms using authenticated Playwright session.",
  "type": "module",
  "main": "src/submit.js",
  "scripts": {
    "login": "node scripts/login.js",
    "refresh-session": "node scripts/refresh-session.js",
    "diagnose": "node scripts/diagnose-form.js",
    "start": "node src/submit.js",
    "test": "node --test",
    "postinstall": "npx playwright install chromium"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaurav-205/Journal.git"
  },
  "keywords": [
    "playwright",
    "automation",
    "google-forms",
    "github-actions",
    "daily-journal",
    "coursework",
    "cron"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "playwright": "^1.50.1"
  }
}
